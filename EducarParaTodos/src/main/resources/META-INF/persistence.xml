<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

	<persistence-unit name="EducarParaTodosPU" transaction-type="RESOURCE_LOCAL">
		<!-- El proveedor de JPA que usaremos es Hibernate -->
		<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

		<!-- Registramos nuestra entidad (Clase modelo) -->
		<class>cl.EducarParaTodos.modelo.Producto</class>

		<properties>
			<!-- Conexión a tu servidor local en la IP 192.168.1.9 -->
			<property name="jakarta.persistence.jdbc.url"
				value="jdbc:mysql://192.168.1.9:3306/Naty?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC" />
			<property name="jakarta.persistence.jdbc.user" value="naty" />
			<property name="jakarta.persistence.jdbc.password"
				value="AbC12313e1985" />
			<property name="jakarta.persistence.jdbc.driver"
				value="com.mysql.cj.jdbc.Driver" />

			<!-- Configuración de Hibernate -->
			<!-- update: Crea o actualiza las tablas automáticamente según tus
			clases Java -->
			<property name="hibernate.hbm2ddl.auto" value="update" />
			<!-- Muestra en consola el SQL que se está ejecutando (útil para
			debug) -->
			<property name="hibernate.show_sql" value="true" />
			<property name="hibernate.format_sql" value="true" />
		</properties>
	</persistence-unit>
</persistence>